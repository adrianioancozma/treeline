{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "APMGIT CLIENT",
  "version": "0.1.0",
  "identifier": "com.apm.apmgitclient",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "APMGIT CLIENT",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "APM",
    "category": "DeveloperTool",
    "shortDescription": "A fast, provider-independent Git client",
    "longDescription": "APMGIT CLIENT is a fast desktop Git client with tabs, bookmarks, submodules, history graph, staging by hunk or line, merge and rebase tools. It works with any Git remote.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
